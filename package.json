{
  "name": "bot_facebook",
  "version": "1.0.0",
  "description": "Multi-Account Facebook Comment Bot with Playwright Stealth, Session Management, Spintax, and Proxy Support",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "telegram": "node src/telegram/bot.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node src/test/test_utils.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate && playwright install chromium",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart fb-bot-telegram",
    "pm2:stop": "pm2 stop fb-bot-telegram",
    "pm2:logs": "pm2 logs fb-bot-telegram"
  },
  "keywords": [
    "facebook",
    "bot",
    "playwright",
    "stealth",
    "spintax",
    "multi-account",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.6.1",
    "inquirer": "^9.2.23",
    "otplib": "^12.0.1",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "vitest": "^4.1.11"
  }
}
